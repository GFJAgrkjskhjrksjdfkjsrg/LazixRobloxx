-- Services
local Players = game:GetService("Players")

local player = Players.LocalPlayer


-- Settings
local hitboxEnabled = false

local hitboxX = 4.521
local hitboxY = 5.73
local hitboxZ = 2.398


local originalSize = nil


-- Hitbox Function
local function updateHitbox()

    local character = player.Character

    if not character then
        return
    end

    local hitbox = character:FindFirstChild("Hitbox")

    if hitbox and hitbox:IsA("BasePart") then
        
        if hitboxEnabled then

            if not originalSize then
                originalSize = hitbox.Size
            end

            hitbox.Size = Vector3.new(
                hitboxX,
                hitboxY,
                hitboxZ
            )

            hitbox.Transparency = 1

        else

            if originalSize then
                hitbox.Size = originalSize
            end

        end

    end
end


-- Character respawn support
player.CharacterAdded:Connect(function(character)

    originalSize = nil

    local hitbox = character:WaitForChild("Hitbox", 5)

    if hitbox then
        updateHitbox()
    end

end)


-- Tab

local HitboxTab = Window:CreateTab("Hitbox", "box")

local Section = HitboxTab:CreateSection("Hitbox Settings")


local Toggle = HitboxTab:CreateToggle({

   Name = "Hitbox",

   CurrentValue = false,

   Flag = "Toggle1",

   Callback = function(Value)

      hitboxEnabled = Value

      updateHitbox()

   end,

})


